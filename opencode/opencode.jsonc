{
  "$schema": "https://opencode.ai/config.json",
  "model": "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",
  "default_agent": "build",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "opencode-sessions@latest",
    "@gotgenes/opencode-agent-identity",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@cortexkit/opencode-magic-context@latest"
  ],
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "edit": "ask",
    "bash": "ask",
    "task": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.4-mini",
      "description": "Default primary agent for implementation. Routes to explore/general for reconnaissance, plan for complex work, and debug for root cause analysis. Uses structured handoffs.",
      "permission": {
        "edit": "allow",
        "bash": {
          "git push*": "deny",
          "*": "allow"
        },
        "task": {
          "docx-vision": "allow",
          "fast": "allow",
          "debug": "allow",
          "general": "allow",
          "explore": "allow",
          "discovery": "allow",
          "feature-manager": "allow",
          "builder": "allow",
          "planner": "allow",
          "reviewer": "allow",
          "implementer": "allow",
          "shipper": "allow",
          "testing": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "description": "Planning specialist for complex work. Analyzes requirements, creates phased plans, and hands off to build for implementation. Uses structured handoffs.",
      "prompt": "You are a planning specialist. Analyze repository context before proposing changes. Generate phased plans with atomic tasks, acceptance criteria, target files, and validation. Prefer small, reversible, testable changes. By default, write every substantial plan to `.opencode/plans/YYYY-MM-DD-<slug>.md`; create `.opencode/plans/` first if needed. After writing the file, summarize the plan clearly in the chat.",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": {
          "*": "deny",
          "fast": "allow",
          "general": "allow",
          "explore": "allow",
          "discovery": "allow",
          "feature-manager": "allow",
          "planner": "allow",
          "reviewer": "allow",
          "shipper": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "fast": {
      "mode": "subagent",
      "model": "github-copilot/gemini-3-flash-preview",
      "description": "Quick answers and trivial lookups. Hands off to general/build if scope exceeds one-step tasks. Uses structured handoffs.",
      "prompt": "You are a fast assistant. Solve small tasks with as few steps as possible. Return results with a structured handoff block. If the work needs broader investigation or larger changes, escalate to @general or @build with full context.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny"
      }
    },
    "debug": {
      "mode": "subagent",
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "description": "Root cause analysis and systematic debugging. Evidence-driven hypothesis testing. Returns findings via structured handoffs.",
      "prompt": "You are a debugging specialist. Start from symptoms and evidence, narrow the search space, propose one primary hypothesis with a falsification check, and prioritize the smallest fix that resolves the root cause. When reporting findings or handing off, use the structured handoff block format.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "discovery": "allow",
          "testing": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "model": "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",
      "description": "General-purpose workhorse for research, multistep tasks, and write-enabled exploration. Routes to plan for complex architecture, debug for root cause analysis, and build for implementation.",
      "prompt": "You are a general-purpose agent for complex research and multistep work. Prefer @explore for read-only reconnaissance first. Delegate to @plan for phased approaches, @debug for systematic problem solving, and return to @build for implementation. Use structured handoff blocks when delegating or completing work.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "fast": "allow",
          "debug": "allow",
          "explore": "allow",
          "discovery": "allow",
          "feature-manager": "allow",
          "builder": "allow",
          "planner": "allow",
          "reviewer": "allow",
          "implementer": "allow",
          "shipper": "allow",
          "testing": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "github-copilot/gemini-3-flash-preview",
      "description": "Cheap read-only reconnaissance. Locates files, patterns, and structure. Hands off to general/build with structured context.",
      "prompt": "You are a fast, read-only repo explorer. Locate files, find patterns, and understand structure without making changes. When findings are complete, report back using the structured handoff block format, listing all relevant files and context found.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    }
  },
  "provider": {
    "fireworks-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "env": [
        "FIREWORKS_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1"
      },
      "models": {
        "accounts/fireworks/routers/kimi-k2p5-turbo": {
          "name": "Kimi K2.5 Turbo (Fire Pass)",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  }
}
