{
  "$schema": "https://opencode.ai/config.json",
  "model": "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",
  "default_agent": "build",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "opencode-sessions@latest",
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "edit": "ask",
    "bash": "ask",
    "task": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.4-mini",
      "description": "Primary implementation agent with controlled delegation.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "fast": "allow",
          "debug": "allow",
          "general": "allow",
          "explore": "allow",
          "discovery": "allow",
          "feature-manager": "allow",
          "builder": "allow",
          "planner": "allow",
          "reviewer": "allow",
          "implementer": "allow",
          "shipper": "allow",
          "testing": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "description": "Analyzes and plans, writing plan files by default.",
      "prompt": "You are a planning specialist. Analyze repository context before proposing changes. Generate phased plans with atomic tasks, acceptance criteria, target files, and validation. Prefer small, reversible, testable changes. By default, write every substantial plan to `.opencode/plans/YYYY-MM-DD-<slug>.md`; create `.opencode/plans/` first if needed. After writing the file, summarize the plan clearly in the chat.",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": {
          "*": "deny",
          "fast": "allow",
          "general": "allow",
          "explore": "allow",
          "discovery": "allow",
          "feature-manager": "allow",
          "planner": "allow",
          "reviewer": "allow",
          "shipper": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "fast": {
      "mode": "subagent",
      "model": "github-copilot/gemini-3-flash-preview",
      "description": "Small tasks and quick answers with minimal context.",
      "prompt": "You are a fast assistant. Solve small tasks with as few steps as possible. If the work needs broad investigation or larger changes, say so and hand it back to a stronger agent.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny"
      }
    },
    "debug": {
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "description": "Deep debugging, hypothesis testing, and evidence-based small fixes.",
      "prompt": "You are a debugging specialist. Start from symptoms and evidence, narrow the search space, propose one primary hypothesis with a falsification check, and prioritize the smallest fix that resolves the root cause.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "discovery": "allow",
          "testing": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "model": "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",
      "description": "General-purpose agent for complex research and multistep work.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "fast": "allow",
          "debug": "allow",
          "explore": "allow",
          "discovery": "allow",
          "feature-manager": "allow",
          "builder": "allow",
          "planner": "allow",
          "reviewer": "allow",
          "implementer": "allow",
          "shipper": "allow",
          "testing": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "github-copilot/gemini-3-flash-preview",
      "description": "Fast read-only repo explorer for locating files, patterns, and clues.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow"
      }
    }
  },
  "provider": {
    "fireworks-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "env": ["FIREWORKS_API_KEY"],
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1"
      },
      "models": {
        "accounts/fireworks/routers/kimi-k2p5-turbo": {
          "name": "Kimi K2.5 Turbo (Fire Pass)",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  }
}
